# local settings and per-PC state
config.json
tools/*_window.json

# run output (logs, hits, frames) and files the helper writes at run time
runs/
knowledge/gamedata.json
knowledge/bestiary_game.json
knowledge/wiki_bestiary.json
knowledge/playbook_game.json
knowledge/telegraphs.txt
knowledge/bench_rooms.json
# benchmark suites are frozen on each PC from its own logs (tools/bench.py freeze); room names come from the game
knowledge/bench_suite_*.json
# measured enemy behaviour (tools/recorder.py): game-derived
knowledge/behaviour_profiles.json

# Python / backups
__pycache__/
*.pyc
*.bak*

# never commit the game's own (unpacked) resources
resources/
resources-dlc3/
*.anm2

# private working notes and local-only files
PLAN.private.md
LAPTOP_SETUP.md
laptop-results/
knowledge/magicaleye/
knowledge/*.overgrown-*
tools/setup_laptop_share.ps1

privacy_words.txt
